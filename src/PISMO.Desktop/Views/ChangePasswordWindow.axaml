<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PISMO.Views.ChangePasswordWindow"
        Title="PISMO — Смена пароля"
        Width="400" Height="380"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgChatBrush}">

    <StackPanel Margin="40" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="Смена пароля" FontSize="22" FontWeight="Bold"
                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10" />

        <TextBlock Text="СТАРЫЙ ПАРОЛЬ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
        <TextBox x:Name="TxtOld" PasswordChar="●" />

        <TextBlock Text="НОВЫЙ ПАРОЛЬ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
        <TextBox x:Name="TxtNew" PasswordChar="●" Watermark="Минимум 8 символов" />

        <TextBlock Text="ПОВТОР ПАРОЛЯ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
        <TextBox x:Name="TxtConfirm" PasswordChar="●" />

        <TextBlock x:Name="LblError" IsVisible="False" TextWrapping="Wrap"
                   Foreground="{StaticResource RedBrush}" FontSize="12" />

        <Button x:Name="BtnUpdate" Classes="blurple" Content="Изменить пароль"
                HorizontalAlignment="Stretch" Margin="0,6,0,0" />
    </StackPanel>
</Window>
