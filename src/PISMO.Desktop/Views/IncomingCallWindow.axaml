<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PISMO.Views.IncomingCallWindow"
        Title="PISMO — Входящий звонок"
        Width="360" Height="380"
        CanResize="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgChatBrush}">

    <StackPanel VerticalAlignment="Center" Spacing="16" Margin="30">
        <TextBlock Text="Входящий звонок" FontSize="14"
                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />

        <Border Width="100" Height="100" CornerRadius="50" HorizontalAlignment="Center"
                Background="{StaticResource GreenBrush}">
            <TextBlock x:Name="AvatarLetter" Text="?" FontSize="44" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <TextBlock x:Name="CallerName" Text="" FontSize="20" FontWeight="Bold"
                   Foreground="White" HorizontalAlignment="Center" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30"
                    Margin="0,16,0,0">
            <StackPanel Spacing="6">
                <Button x:Name="BtnAccept" Width="64" Height="64" CornerRadius="32"
                        Background="{StaticResource GreenBrush}" Foreground="White"
                        FontSize="26" Cursor="Hand" Content="📞"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                <TextBlock Text="Принять" Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Spacing="6">
                <Button x:Name="BtnReject" Width="64" Height="64" CornerRadius="32"
                        Background="{StaticResource RedBrush}" Foreground="White"
                        FontSize="26" Cursor="Hand" Content="📵"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                <TextBlock Text="Отклонить" Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
